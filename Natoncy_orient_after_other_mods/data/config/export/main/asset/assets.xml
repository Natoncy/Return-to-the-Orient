<ModOps>

    <!-- every scholar need not listed here becomes vanilla-residence only (114445).
         Listed: the Orient replacements (main mod population_levels/assets_scholars.xml) and the needs both
         residences share: Seafood Stew, Leather Boots, Tapestries (= Rugs), bonus needs 1010232/5392/5395/5391 -->
    <ModOp Type="add" GUID="118745" Path="Values/PopulationLevel7/PopulationInputs/Item[Product!='1404001116' and Product!='1404005087' and Product!='1404005120' and Product!='1404000253' and Product!='1404000283' and Product!='1404000265' and Product!='1400201044' and Product!='1404005131' and Product!='1404000250' and Product!='1404000288' and Product!='1404000241' and Product!='114410' and Product!='114428' and Product!='114404' and Product!='1010232' and Product!='5392' and Product!='5395' and Product!='5391']">
        <RequiredBuildings>
            <Item>
                <RequiredBuilding>114445</RequiredBuilding>
            </Item>
        </RequiredBuildings>
    </ModOp>

    <!-- pearl diver gets the effects of other mods' pearl farm items.
         shared-pools-and-definitions replaces the pearl farm 1010339 in EffectTargets with its pool 1500301936 -->
    <ModOp Type="add" Path="//ItemEffect/EffectTargets[Item/GUID='1010339' or Item/GUID='1500301936'][not(Item/GUID='1404000861')]" AllowNoMatch="1">
        <Item>
            <GUID>1404000861</GUID>
        </Item>
    </ModOp>

    <!-- Orient scholars get the effects of other mods' items aimed at the scholar residence 114445,
         directly or through a target pool. Vanilla ones: main mod items/assets_vanilla_scholar_items.xml -->
    <ModOp Type="add" Path="//ItemEffect/EffectTargets[Item/GUID='114445'][not(Item/GUID='1404001113')]" AllowNoMatch="1">
        <Item>
            <GUID>1404001113</GUID>
        </Item>
    </ModOp>
    <ModOp Type="add" Path="//ItemEffectTargetPool/EffectTargetGUIDs[Item/GUID='114445'][not(Item/GUID='1404001113')]" AllowNoMatch="1">
        <Item>
            <GUID>1404001113</GUID>
        </Item>
    </ModOp>

