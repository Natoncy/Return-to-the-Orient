<ModOps>

    <!-- TEST ONLY - do not ship. Rename the folder to "-Natoncy_orient_test_triggers" or delete it to switch it off.
         Pending triggers in a save keep the thresholds they were registered with.
         The trigger reset submod re-registers them only once per main mod version, so use a new game. -->

    <!-- Creative: unlock only the session and the creative menu, so the population triggers do the rest -->
    <ModOp Type="replace" GUID="1404000791" Path="/Values/Trigger/TriggerActions/Item/TriggerAction/Values/ActionUnlockAsset/UnlockAssets">
        <UnlockAssets>
            <Item>
                <Asset>1404000000</Asset>
            </Item>
            <Item>
                <Asset>1404000614</Asset>
            </Item>
        </UnlockAssets>
    </ModOp>

    <!-- Nomads: 1.1 = 1, 1.2 = 2, 1.3 = 3, 1.4 = 4 -->
    <ModOp Type="replace" GUID="1404000814" Path="/Values/Trigger/TriggerCondition/Values/ConditionPlayerCounter/CounterAmount">
        <CounterAmount>1</CounterAmount>
    </ModOp>
    <ModOp Type="replace" GUID="1404000815" Path="/Values/Trigger/TriggerCondition/Values/ConditionPlayerCounter/CounterAmount">
        <CounterAmount>2</CounterAmount>
    </ModOp>
    <ModOp Type="replace" GUID="1404000816" Path="/Values/Trigger/TriggerCondition/Values/ConditionPlayerCounter/CounterAmount">
        <CounterAmount>3</CounterAmount>
    </ModOp>
    <ModOp Type="replace" GUID="1404000817" Path="/Values/Trigger/TriggerCondition/Values/ConditionPlayerCounter/CounterAmount">
        <CounterAmount>4</CounterAmount>
    </ModOp>

    <!-- Envoys: 2.0 = 1 (unchanged), 2.1 = 2, 2.2 = 3, ... 2.8 = 9. Side triggers get their tier's value;
         their Old World population and DLC sub-conditions are unchanged. -->
    <ModOp Type="replace" GUID="1404000819" Path="/Values/Trigger/TriggerCondition/Values/ConditionPlayerCounter/CounterAmount">
        <CounterAmount>2</CounterAmount>
    </ModOp>
    <ModOp Type="replace" GUID="1404001016,1404001260"Path="/Values/Trigger/TriggerCondition/Values/ConditionPlayerCounter/CounterAmount">
        <CounterAmount>3</CounterAmount>
    </ModOp>
    <ModOp Type="replace" GUID="1404000820,1404001270"Path="/Values/Trigger/TriggerCondition/Values/ConditionPlayerCounter/CounterAmount">
        <CounterAmount>4</CounterAmount>
    </ModOp>
    <ModOp Type="replace" GUID="1404000821,1404001263,1404001264"Path="/Values/Trigger/TriggerCondition/Values/ConditionPlayerCounter/CounterAmount">
        <CounterAmount>5</CounterAmount>
    </ModOp>
    <ModOp Type="replace" GUID="1404000822,1404001267,1404001268" Path="/Values/Trigger/TriggerCondition/Values/ConditionPlayerCounter/CounterAmount">
        <CounterAmount>6</CounterAmount>
    </ModOp>
    <ModOp Type="replace" GUID="1404000823" Path="/Values/Trigger/TriggerCondition/Values/ConditionPlayerCounter/CounterAmount">
        <CounterAmount>7</CounterAmount>
    </ModOp>
    <ModOp Type="replace" GUID="1404000824" Path="/Values/Trigger/TriggerCondition/Values/ConditionPlayerCounter/CounterAmount">
        <CounterAmount>8</CounterAmount>
    </ModOp>
    <ModOp Type="replace" GUID="1404000825" Path="/Values/Trigger/TriggerCondition/Values/ConditionPlayerCounter/CounterAmount">
        <CounterAmount>9</CounterAmount>
    </ModOp>

    <!-- Scholars: 3.0 = 1 (unchanged), 3.1 = 2, ... 3.5 = 6; their Envoy sub-condition 3600 -> 9 (= 2.8) -->
    <ModOp Type="replace" GUID="1404001157" Path="/Values/Trigger/TriggerCondition/Values/ConditionPlayerCounter/CounterAmount">
        <CounterAmount>2</CounterAmount>
    </ModOp>
    <ModOp Type="replace" GUID="1404001158" Path="/Values/Trigger/TriggerCondition/Values/ConditionPlayerCounter/CounterAmount">
        <CounterAmount>3</CounterAmount>
    </ModOp>
    <ModOp Type="replace" GUID="1404001159" Path="/Values/Trigger/TriggerCondition/Values/ConditionPlayerCounter/CounterAmount">
        <CounterAmount>4</CounterAmount>
    </ModOp>
    <ModOp Type="replace" GUID="1404001160" Path="/Values/Trigger/TriggerCondition/Values/ConditionPlayerCounter/CounterAmount">
        <CounterAmount>5</CounterAmount>
    </ModOp>
    <ModOp Type="replace" GUID="1404001161" Path="/Values/Trigger/TriggerCondition/Values/ConditionPlayerCounter/CounterAmount">
        <CounterAmount>6</CounterAmount>
    </ModOp>
    <ModOp Type="replace" GUID="1404001156,1404001157,1404001158,1404001159,1404001160,1404001161" Path="/Values/Trigger/SubTriggers/Item/SubTrigger/Values/Trigger/TriggerCondition/Values/ConditionPlayerCounter[Context='1404000011']/CounterAmount">
