<ModOps>

    <!-- Orient Set 02 (Silver, No Oil)
         silver, silver, beryl, clay, silver, clay, silver
         silver x4, beryl x1, clay x2

         Mirrors the New World's 141557 Set 02 (Gold, No Oil), with gold replaced by
         silver (1404001281) so clay and oil keep their Colony01 frequency.
         Beryl (1404003905) took one entry of the set's most frequent resource (2026-10-31).
         Order matters: the generator walks MineSlots up to the island's mine
         budget, so the first entries are the ones most likely to be placed. -->

    <ModOp Type="addNextSibling" GUID="141554">
        <Asset>
            <Template>MineSlotSet</Template>
            <Values>
                <Standard>
                    <GUID>1404001295</GUID>
                    <Name>Orient Set 02 (Silver, No Oil)</Name>
                </Standard>
                <ResourceSetCondition>
                    <Priority>10</Priority>
                    <AllowedRegion>Mod3</AllowedRegion>
                    <AllowedIslandType>Normal;Starter</AllowedIslandType>
                    <AllowedIslandDifficulty>Normal;Hard</AllowedIslandDifficulty>
                    <AllowedResourceAmounts>Low;Medium;High</AllowedResourceAmounts>
                </ResourceSetCondition>
                <MineSlotResourceSet>
                    <MineSlots>
                        <Item>
                            <MineSlot>1404001281</MineSlot>
                        </Item>
                        <Item>
                            <MineSlot>1404001281</MineSlot>
                        </Item>
                        <Item>
                            <MineSlot>1404003905</MineSlot>
                        </Item>
                        <Item>
                            <MineSlot>101061</MineSlot>
                        </Item>
                        <Item>
                            <MineSlot>1404001281</MineSlot>
                        </Item>
                        <Item>
                            <MineSlot>101061</MineSlot>
                        </Item>
                        <Item>
                            <MineSlot>1404001281</MineSlot>
                        </Item>
                    </MineSlots>
                </MineSlotResourceSet>
            </Values>
        </Asset>
    </ModOp>

</ModOps>
