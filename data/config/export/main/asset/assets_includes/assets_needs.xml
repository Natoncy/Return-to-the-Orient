<!-- Add Happiness Needs to different population
     Each need unlocks at NoWeightPopulationCount + 1 of its own tier and at the Envoy count in
     AdditionalGlobalUnlockRequirement. That Envoy count is the one of the Orient trigger that unlocks the
     good's pool (skyscraper and Scholar stages: the Envoy count they require), and the pool is the only
     production unlock, so change them together. Incense has no Orient unlock yet: its export trigger
     in triggers/assets_intermediate_orient_2_4/2_5.xml unlocks the production at the same two counts. -->

<ModOps>

    <!-- ## ENBESA ## -->
    <!-- ## Elders: Spiced Tea ## -->
    <ModOp Type="addNextSibling" GUID="114330" Path="Values/PopulationLevel7/PopulationInputs/Item[Product='114362']">
        <Item>
            <Product>1400201044</Product>
            <Amount>0.0002</Amount>
            <HappinessValue>3</HappinessValue>
            <MoneyValue>35</MoneyValue>
            <FullWeightPopulationCount>1300</FullWeightPopulationCount>
            <NoWeightPopulationCount>999</NoWeightPopulationCount>
            <IsConsideredByAI>0</IsConsideredByAI>
            <AdditionalGlobalUnlockRequirement>
