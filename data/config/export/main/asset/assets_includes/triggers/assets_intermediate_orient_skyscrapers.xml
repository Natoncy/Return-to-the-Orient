<ModOps>

    <!-- Envoy skyscraper needs, like vanilla's "skyscraper unlocks 1.x" for Investors (e.g. 1.3 = 136120):
         a level's first need unlocks when 1 house of that level stands, its second need and the next level
         when 15 stand. Level 2 (FloorLevel 1) itself unlocks at 6000 Envoys (trigger 2.8). -->
    <ModOp Type="addNextSibling" GUID="10138">
        <!-- 1 Envoy residence level 2 built: rose water -->
        <Asset>
            <Template>Trigger</Template>
            <Values>
                <Standard>
                    <GUID>1404004027</GUID>
                    <Name>Intermediate Orient Skyscraper 1.1</Name>
                </Standard>
                <Trigger>
                    <TriggerCondition>
                        <Template>ConditionPlayerCounter</Template>
                        <Values>
                            <Condition/>
                            <ConditionPlayerCounter>
                                <PlayerCounter>ObjectBuilt</PlayerCounter>
                                <Context>1404004300</Context>
                                <CounterAmount>1</CounterAmount>
                            </ConditionPlayerCounter>
                        </Values>
                    </TriggerCondition>
                    <TriggerActions>
                        <Item>
                            <TriggerAction>
                                <Template>ActionUnlockAsset</Template>
                                <Values>
                                    <Action/>
                                    <ActionUnlockAsset>
                                        <UnlockAssets>
                                            <Item>
                                                <Asset>1404000786</Asset> <!-- Rose Water -->
                                            </Item>
                                        </UnlockAssets>
                                        <UnhideAssets>
                                            <Item>
                                                <Asset>1404005036</Asset> <!-- candied dates -->
                                            </Item>
                                            <Item>
                                                <Asset>1404004301</Asset> <!-- residence level 3 -->
                                            </Item>
                                        </UnhideAssets>
                                    </ActionUnlockAsset>
                                </Values>
                            </TriggerAction>
                        </Item>
                    </TriggerActions>
                    <ResetTrigger>
                        <IsBaseAutoCreateAsset>1</IsBaseAutoCreateAsset>
                        <Values>
                            <EmptyAutoCreateValue/>
                        </Values>
                    </ResetTrigger>
                </Trigger>
                <TriggerSetup/>
            </Values>
        </Asset>

