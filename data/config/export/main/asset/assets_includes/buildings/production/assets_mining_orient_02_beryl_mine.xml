<ModOps>

    <!-- quartz Mine: the Silver Ore Mine's model mirrored left/right (z -> -z, mining_orient_02), so it keeps the
         mine-slot footprint (3x3 entrance + 5x5 yard on +x). The Orient's free slot type Tin carries the quartz deposit
         1404003905; Region Orient SlotBuildings maps Tin to this mine. 30 s cycle = one mine per Mosaic Workshop. -->
    <ModOp Type="addNextSibling" GUID="1404001300">
        <Asset>
            <BaseAssetGUID>1010311</BaseAssetGUID>
            <Values>
                <Standard>
                    <GUID>1404003903</GUID>
                    <Name>mining_orient_02 (quartz Mine)</Name>
                    <IconFilename>data/modgraphics/ui/icon_quartz.png</IconFilename>
                    <InfoDescription>11143</InfoDescription>
                </Standard>
                <Building>
                    <AssociatedRegions>Mod3</AssociatedRegions>
                    <SecondPartyRelevant>0</SecondPartyRelevant>
                </Building>
                <Blocking/>
                <Cost>
                    <Costs>
                        <Item>
                            <Ingredient>1010017</Ingredient>
                            <Amount>2500</Amount>
                        </Item>
                        <Item>
                            <Ingredient>1400201040</Ingredient>
                            <Amount>20</Amount>
                        </Item>
                        <Item>
                            <Ingredient>1404009000</Ingredient>
                            <Amount>25</Amount>
                        </Item>
                    </Costs>
                </Cost>
                <Object>
                    <Variations>
                        <Item>
                            <Filename>data/graphics/buildings/orient/mining_orient_02/mining_orient_02.cfg</Filename>
                        </Item>
                    </Variations>
                </Object>
                <Mesh/>
                <Selection>
                    <OnSelection>
                        <IsBaseAutoCreateAsset>1</IsBaseAutoCreateAsset>
                        <Values>
                            <ActionList/>
                        </Values>
                    </OnSelection>
                    <ParticipantMessageArcheType>Mod8</ParticipantMessageArcheType>
                </Selection>
                <Text>
                    <LocaText>
                        <English>
                            <Text>quartz Mine</Text>
                            <Status>Exported</Status>
                        </English>
                    </LocaText>
                </Text>
                <Constructable/>
                <Locked/>
                <SoundEmitter>
                    <ActiveSounds>
                        <Item>
                            <Sound>202274</Sound>
                        </Item>
                    </ActiveSounds>
                </SoundEmitter>
                <FeedbackController/>
                <Infolayer/>
                <UpgradeList/>
                <Factory7/>
                <FactoryBase>
                    <FactoryInputs>
                        <Item>
                            <Product>1591</Product>
                            <StorageAmount>6</StorageAmount>
                        </Item>
                    </FactoryInputs>
                    <FactoryOutputs>
                        <Item>
                            <Product>1404003900</Product>
                            <Amount>1</Amount>
                            <StorageAmount>6</StorageAmount>
                        </Item>
                    </FactoryOutputs>
                    <CycleTime>30</CycleTime>
                    <IsMainFactory>0</IsMainFactory>
                </FactoryBase>
                <LogisticNode/>
                <Slot>
                    <SlotType>Tin</SlotType>
                    <WorkArea>1404003904</WorkArea>
                </Slot>
                <AmbientMoodProvider/>
                <Maintenance>
                    <Maintenances>
                        <Item>
                            <Product>1010017</Product>
                            <Amount>120</Amount>
                            <InactiveAmount>60</InactiveAmount>
                        </Item>
                        <Item>
                            <Product>1404000012</Product>
                            <Amount>100</Amount>
                        </Item>
                    </Maintenances>
                </Maintenance>
                <Attackable/>
                <Pausable/>
                <IncidentInfectable/>
                <Culture/>
                <Industrializable>
                    <BoostedByIndustrialization>0</BoostedByIndustrialization>
                    <MandatoryIndustrialization>0</MandatoryIndustrialization>
                </Industrializable>
                <Electrifiable>
                    <ElectrifiedEffect>0</ElectrifiedEffect>
                    <ElectricityBoost>0</ElectricityBoost>
                    <ShowPowerInObjectMenu>0</ShowPowerInObjectMenu>
                </Electrifiable>
            </Values>
        </Asset>
    </ModOp>

    <!-- the silver mine's work area (gold lift, symmetric about z = 0), as its own asset like vanilla's one per mine -->
    <ModOp Type="addNextSibling" GUID="1404001301">
        <Asset>
            <BaseAssetGUID>1010549</BaseAssetGUID>
            <!--mining_08_workarea (Gold Ore)-->
            <Values>
                <Standard>
                    <GUID>1404003904</GUID>
                    <Name>mining_orient_02_workarea (quartz)</Name>
                </Standard>
                <Object>
                    <Variations>
                        <Item>
                            <Filename>data/graphics/buildings/orient/mining_orient_01/mining_orient_01_workarea.cfg</Filename>
                        </Item>
                    </Variations>
                </Object>
            </Values>
        </Asset>
    </ModOp>

    <!-- item effect target pools and workforce menu -->
    <ModOp Type="add" GUID="6000018,193856,368,190786,190882" Path="/Values/ItemEffectTargetPool/EffectTargetGUIDs">
        <Item>
            <GUID>1404003903</GUID>
        </Item>
    </ModOp>

    <!-- WorkforceMenu/BoostableFactories -->
    <ModOp Type="add" GUID="25000087" Path="/Values/WorkforceMenu/BoostableFactories">
        <Item>
            <Factory>1404003903</Factory>
        </Item>
    </ModOp>

</ModOps>
