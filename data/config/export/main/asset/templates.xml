    <!-- MonumentColony + ItemContainer: every stage of the Oriental Lighthouse (1404004800 -> 7000 -> 7001 -> 7002).
         Like vanilla's airship hangar (Monument_with_Shipyard on all stages, only the last one switches GUIType to
         Shipyard), the completed 7002 stays the same template and only sets the socket and GUIType Guildhouse. So every
         upgrade is a plain GUID change, the monument UI counts the completed lighthouse as phase 4 with its own icon,
         and no UseReplaceInsteadOfChangeGUID is needed. Stages have no SocketCount (0 sockets). Replaces the earlier
         HarborOffice_Unique final, which a GUID change crashed into and a replace left out of the phase count. -->
    <ModOp Template="MonumentColony" Type="addNextSibling">
        <Template>
          <Name>MonumentColony_ItemSocket</Name>
          <Properties>
            <Standard>
              <InfoDescription>100027</InfoDescription>
            </Standard>
            <Building>
              <BuildingType>Factory</BuildingType>
              <BuildingCategoryName>100002</BuildingCategoryName>
              <DestructionConfirmation>1</DestructionConfirmation>
              <AssociatedRegions>Colony01</AssociatedRegions>
            </Building>
            <Blocking />
            <Cost />
            <Object>
              <IgnoreForMinimapGeneration>1</IgnoreForMinimapGeneration>
            </Object>
            <Mesh />
            <Selection>
              <GUIType>Production</GUIType>
              <OnSelection>
                <IsBaseAutoCreateAsset>1</IsBaseAutoCreateAsset>
                <Values>
                  <ActionList />
                </Values>
              </OnSelection>
            </Selection>
            <Text />
            <Constructable>
              <DestructionCategory>Production</DestructionCategory>
            </Constructable>
            <Locked />
            <SoundEmitter>
              <DestroySounds>
                <Item>
                  <Sound>9818756</Sound>
                </Item>
              </DestroySounds>
              <ConstructionSounds>
                <BuildFailed>
                  <Item>
                    <Sound>9818387</Sound>
